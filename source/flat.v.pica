; Voxelia 3DS - vertex shader del mondo di giorno: solo luce ambiente, senza luci puntiformi.
; Di giorno all'aperto le luci non servono: questo shader fa un terzo del lavoro di world.v.pica.

.fvec projection[4]
.fvec ambient

.constf K(0.0, 1.0, 0.00392156862, 0.0)
.alias ONE  K.yyyy
.alias INV255 K.zzzz

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
	mov r0.xyz, inpos
	mov r0.w, ONE
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov r1, ambient
	add r1.xyz, inpos.www, r1.xyz
	min r1.xyz, ONE, r1.xyz

	mul r6, INV255, inclr
	mul outclr.xyz, r6.xyz, r1.xyz
	mov outclr.w, r6.w
	end
.end
